rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      match /cards/{cardId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        
        function isValidCard() {
          let data = request.resource.data;
          return data.keys().hasAll(['id', 'title', 'type', 'nodeType']) &&
                 data.id is string &&
                 data.title is string &&
                 data.type is string &&
                 data.nodeType is string;
        }

        allow create, update: if request.auth != null && 
                              request.auth.uid == userId && 
                              isValidCard();
      }
      
      match /settings/{settingId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Whitelist bêta-testeurs ─────────────────────────────────────────────
    // Un admin crée les documents via la console Firebase.
    // Les utilisateurs peuvent seulement LIRE leur propre document.
    match /allowedUsers/{uid} {
      // Lecture : seulement l'utilisateur concerné
      allow read: if request.auth != null && request.auth.uid == uid;
      // Écriture : uniquement via la console Firebase (admin SDK) → interdit côté client
      allow write: if false;
    }
  }
}
