{
  "name": "pharma-brain",
  "productName": "PharmaBrain",
  "private": true,
  "version": "1.0.0",
  "description": "Base de connaissances pour l'Internat de Pharmacie",
  "author": "PharmaBrain Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/pierrickdcc/secondbrain.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5174 && electron .\"",
    "electron:build": "npm run build && cross-env DEBUG=electron-builder electron-builder build --publish never",
    "dist": "npm run build && electron-builder --mac --win"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/transformers": "^3.8.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@sentry/electron": "^7.15.0",
    "@tanstack/react-query": "^5.101.2",
    "@tiptap/extension-bubble-menu": "^3.26.1",
    "@tiptap/extension-color": "^3.26.0",
    "@tiptap/extension-highlight": "^3.25.0",
    "@tiptap/extension-image": "^3.26.0",
    "@tiptap/extension-link": "^3.25.0",
    "@tiptap/extension-placeholder": "^3.25.0",
    "@tiptap/extension-table": "^3.25.0",
    "@tiptap/extension-table-cell": "^3.25.0",
    "@tiptap/extension-table-header": "^3.25.0",
    "@tiptap/extension-table-row": "^3.25.0",
    "@tiptap/extension-text-align": "^3.25.0",
    "@tiptap/extension-text-style": "^3.26.0",
    "@tiptap/extension-underline": "^3.25.0",
    "@tiptap/pm": "^3.25.0",
    "@tiptap/react": "^3.25.0",
    "@tiptap/starter-kit": "^3.25.0",
    "@tiptap/suggestion": "^3.25.0",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.3",
    "dompurify": "^3.4.11",
    "driver.js": "^1.4.0",
    "electron-is-dev": "^3.0.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.15.0",
    "flexsearch": "^0.8.212",
    "framer-motion": "^12.40.0",
    "genanki-js": "^2.0.0",
    "i18next": "^26.3.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.28",
    "lucide-react": "^0.563.0",
    "marked": "^18.0.5",
    "papaparse": "^5.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-force-graph-2d": "^1.29.1",
    "react-force-graph-3d": "^1.29.1",
    "react-hook-form": "^7.81.0",
    "react-hot-toast": "^2.6.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.8",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.17.0",
    "react-virtuoso": "^4.18.10",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.4.0",
    "tesseract.js": "^7.0.0",
    "tiptap-markdown": "^0.9.0",
    "ts-fsrs": "^5.4.1",
    "uuid": "^14.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "voy-search": "^0.6.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.18",
    "@types/d3-force": "^3.0.10",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.5",
    "@types/react-calendar-heatmap": "^1.9.0",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "react-calendar-heatmap": "^1.10.0",
    "rollup": "^4.57.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "build": {
    "appId": "com.pharmabrain.app",
    "productName": "PharmaBrain",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pierrickdcc",
        "repo": "secondbrain"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*.cjs"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "icon": "public/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PharmaBrain",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeader": "public/installer-header.bmp",
      "installerHeaderIcon": "public/icon.ico",
      "uninstallDisplayName": "PharmaBrain",
      "menuCategory": "PharmaBrain",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "PharmaBrain",
      "icon": "public/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
